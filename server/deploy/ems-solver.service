[Unit]
Description=ems-solver API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/apps/ems-solver/app
EnvironmentFile=/opt/apps/ems-solver/.env
# Localhost only: frpc forwards it to the VPS, which serves solver.ems-place.com.
ExecStart=/opt/apps/ems-solver/venv/bin/uvicorn ems_solver.main:app --host 127.0.0.1 --port 8011 --no-server-header
Restart=always
RestartSec=3

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
